# ── Required ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway or local). Hosted providers: use the pooled URL here.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/greenbridge?schema=public"

# Long random secret that signs session cookies. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Public base URL of the site (used in links inside emails)
NEXTAUTH_URL="http://localhost:3000"

# IANA timezone of your events (event times and check-in times are shown in this timezone)
APP_TIMEZONE="Asia/Kolkata"

# ── Optional: outbound email (password reset, email confirmation, registration confirmations) ──
# Free tier at https://resend.com (verify a sending domain, then create an API key).
# Leave both empty to run without email: reset links are only logged, and sign-ups are not asked to confirm their address.
RESEND_API_KEY=""
MAIL_FROM="Your Organisation <noreply@yourdomain.org>"

# ── Optional: used only by the seed script ─────────────────────────────────
# Password given to every seeded demo account (default Demo@12345 — never use that on a public site).
# SEED_PASSWORD=""
# Use the original fixed demo dates instead of dates relative to today.
# SEED_FIXED_DATES=1
